    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.6.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
